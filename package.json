{
  "name": "cephgrow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-based growth pattern prediction web app for serial cephalograms.",
  "type": "module",
  "scripts": {
    "dev": "npx concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:mobile": "npm run start --prefix mobile",
    "start:mobile": "npm run start --prefix mobile",
    "android": "npm run android --prefix mobile",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "start:backend": "npm run start --prefix backend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:push": "npm run prisma:push --prefix backend"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "selenium-webdriver": "^4.47.0",
    "webdriverio": "^9.31.1"
  }
}
